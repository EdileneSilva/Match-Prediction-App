# =============================================================================
# Match Prediction App - Environment Configuration
# =============================================================================
# Copy this file to `.env` and fill in your values.
# For Docker Compose, these values are used automatically.
# For local development, use the Docker service names as hostnames.
#
# Docker service names:
#   - PostgreSQL: postgres (host) / 5432 (port)
#   - App API: app-api (host) / 8000 (port)
#   - ML API: ml-api (host) / 8001 (port)
#   - Frontend: frontend (host) / 8080 (port)
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------

# API Application database (users, auth, history, favorites)
# Uses: footballapp_db
DATABASE_APP_URL=postgresql://postgres:postgres@postgres:5432/footballapp_db
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/footballapp_db

# API ML database (teams, matches, stats)
# Uses: footballml_db (standardized name)
DATABASE_ML_URL=postgresql://postgres:postgres@postgres:5432/footballml_db

# -----------------------------------------------------------------------------
# JWT Authentication (API Application)
# -----------------------------------------------------------------------------
# Generate a secure key with: openssl rand -hex 32
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Shared API key for internal App API → ML API communication
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
ML_API_KEY=your-ml-api-key-change-me-in-production

# -----------------------------------------------------------------------------
# API URLs
# -----------------------------------------------------------------------------
# ML API URL (from App API perspective)
ML_API_URL=http://ml-api:8001

# -----------------------------------------------------------------------------
# ML Configuration
# -----------------------------------------------------------------------------
DATA_DIR=../Data/dataset/
MODEL_PATH=../Data/dataset/match_model_v1.joblib
DATASET_PATH=../Data/dataset/completed_match_dataset_final.csv
MLFLOW_TRACKING_URI=sqlite:////app/mlflow.db

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins
# For Docker Compose: http://localhost:8080,http://127.0.0.1:8080
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8081,http://127.0.0.1:8081

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
# App API
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false

# ML API
ML_HOST=0.0.0.0
ML_PORT=8001
ML_DEBUG=false

# Frontend
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=8080